# REROUTE Environment Configuration
# Copy this file to .env and fill in your API keys

# ═══════════════════════════════════════════════════════════
# External Data APIs
# ═══════════════════════════════════════════════════════════

# S&P Global Platts — Real-time commodity pricing
# https://www.spglobal.com/commodityinsights/en/products-services/data-insights
PLATTS_API_KEY=your_platts_api_key_here
PLATTS_API_SECRET=your_platts_secret_here

# Lloyd's List Intelligence — Vessel tracking (AIS data)
# https://lloydslistintelligence.com/
LLOYDS_API_KEY=your_lloyds_api_key_here

# MarineTraffic — Alternative AIS provider
# https://www.marinetraffic.com/en/ais-api-services
MARINETRAFFIC_API_KEY=your_marinetraffic_key_here

# U.S. EIA — Energy Information Administration (free, but rate-limited)
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# ICE Data Services — Futures and options data
# https://www.ice.com/market-data
ICE_USERNAME=your_ice_username
ICE_PASSWORD=your_ice_password

# ═══════════════════════════════════════════════════════════
# AI/ML Services
# ═══════════════════════════════════════════════════════════

# OpenAI — For natural language copilot features
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4-turbo # or gpt-4, gpt-3.5-turbo

# Anthropic Claude — Alternative LLM provider
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Hugging Face — For geopolitical risk NLP models
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_hf_token_here

# ═══════════════════════════════════════════════════════════
# Database & Storage
# ═══════════════════════════════════════════════════════════

# PostgreSQL — Time-series data storage
DATABASE_URL=postgresql://user:password@localhost:5432/reroute_db

# Redis — Caching layer for API responses
REDIS_URL=redis://localhost:6379

# AWS S3 — Historical data archives
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=reroute-data-archive
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════

# Environment: development | staging | production
NODE_ENV=development

# Server configuration
PORT=3000
HOST=localhost

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ═══════════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════════

# Enable real-time vessel tracking
ENABLE_AIS_TRACKING=true

# Enable AI copilot features
ENABLE_AI_COPILOT=true

# Enable Monte Carlo simulations
ENABLE_MONTE_CARLO=true

# Enable email alerts
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@reroute.energy
SMTP_PASSWORD=your_smtp_password

# ═══════════════════════════════════════════════════════════
# Monitoring & Logging
# ═══════════════════════════════════════════════════════════

# Sentry — Error tracking
# https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# DataDog — APM and metrics
# https://www.datadoghq.com/
DATADOG_API_KEY=your_datadog_key_here

# Log level: error | warn | info | http | verbose | debug
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════
# Simulation Parameters (Defaults)
# ═══════════════════════════════════════════════════════════

# Monte Carlo iterations
DEFAULT_MC_ITERATIONS=5000

# Price model decay rate
DEFAULT_DECAY_RATE=0.015

# Risk threshold (0-10 scale)
DEFAULT_RISK_THRESHOLD=8.0

# SPR release lag (days)
DEFAULT_SPR_RELEASE_LAG=14

# ═══════════════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════════════

# - Never commit .env file to version control
# - Rotate API keys regularly
# - Use separate keys for dev/staging/prod
# - Some APIs (Platts, ICE) require enterprise subscriptions
# - Free tier: EIA, limited MarineTraffic access
